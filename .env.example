# Clave de API de IA (leída por el backend, nunca se sube a GitHub)
API_IA_CLAVE=tu_clave_aqui

# Clave secreta de Flask (firma las cookies de sesión)
SECRET_KEY=dev-cambiar-en-produccion

# Primera cuenta administradora automática (opcional).
# Solo se usa cuando la base todavía no tiene ninguna cuenta: sirve para
# servidores sin consola cómoda, como Render. Después del primer ingreso,
# conviene quitar RAA_ADMIN_CLAVE del panel.
# RAA_ADMIN_CORREO=admin@raa.cr
# RAA_ADMIN_CLAVE=una-clave-de-8-o-mas-caracteres
# RAA_ADMIN_NOMBRE=Administración RAA

# Opcionales
# RAA_DB_PATH=datos/raa.db          # ubicación de la base de cuentas
# RAA_EXCEL_PATH=datos/eventos.xlsx # Excel alternativo de eventos
# RAA_COOKIE_SEGURA=1               # 1 solo si el sitio se sirve por HTTPS
